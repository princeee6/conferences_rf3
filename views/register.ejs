<h1><%= title %></h1>

<% if (errors.lenght) { %>
    <ul>
        <% errors.forEach(e => { %>
        <li><%= e %></li>
        <% }) %>
    </ul>
<% } %>

<form method="POST" action="/register">
<input name="login" placeholder="логин"><br>
<input name="fio" placeholder="ФИО"><br>
