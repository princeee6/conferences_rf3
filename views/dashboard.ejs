<h1><%= title %></h1>
<p>Пользователь: <%= user.fio %></p>

<% if (requests?.length) { %>
  <% requests.forEach(req => { %>
    <div><%= req.room_name %> — <%= req.status %></div>
  <% }); %>
<% } else { %>
  <div>Заявок нет</div>
<% } %>

